{{>header}}

<div class="container">
    <div class="row justify-content-center align-items-center h-100">
        <div class="col-12 col-xl-6">
            <div class="card shadow container rounded-4 py-3 my-3">
                <div class="row">
                    <div class="col-12 col-sm-auto d-flex justify-content-center mb-3">
                        <div style="width: 100px;">
                            <img src="{{perfil_qr}}" class="img-thumbnail" alt="Perfil de {{usuario.username}}" />
                        </div>
                    </div>  
                    <div class="col d-flex flex-column align-items-center align-items-sm-start justify-content-center mb-3">
                        <div class="d-flex gap-2">
                            {{#propio}}
                            <h1 class="fs-3 fw-bold align-content-center my-0">Tu Perfil</h1>
                            {{/propio}}
                            {{^propio}}
                            <h1 class="fs-3 fw-bold align-content-center my-0">Perfil de {{usuario.username}}</h1>
                            {{/propio}}
                        </div>
                    </div>
                </div>
                <div class="row pb-3">
                    <div class="col">
                        <div class="container">
                            <div class="row mt-3">
                                <div class="col">
                                    <h3 class="fs-4">Datos de Juego</h3>
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="col-12 col-sm-6 mb-3">
                                    <label for="nombre" class="form-label fs-7 fw-bold text-secondary mb-1">Rango</label>
                                    <input type="text" class="form-control-plaintext" id="nombre" readonly value="# {{usuario.ranking}}">
                                </div>
                                <div class="col-12 col-sm-6 mb-3">
                                    <label for="nombre" class="form-label fs-7 fw-bold text-secondary mb-1">Puntaje Total</label>
                                    <input type="text" class="form-control-plaintext" id="nombre" readonly value="{{usuario.puntaje_total}}">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row pb-3">
                    <div class="col">
                        <form action="/perfilusuario/actualizar" method="POST" enctype="multipart/form-data" class="container">
                            <div class="row mt-3">
                                <div class="col">
                                    <h3 class="fs-4">Datos Personales</h3>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12 col-sm-6 mb-3">
                                    <label for="nombre" class="form-label fs-7 fw-bold text-secondary mb-1">Nombre</label>
                                    <input type="text" class="form-control-plaintext" id="nombre" readonly value="{{usuario.nombre}}">
                                </div>
                                <div class="col-12 col-sm-6 mb-3">
                                    <label for="apellido" class="form-label fs-7 fw-bold text-secondary mb-1">Apellido</label>
                                    <input type="text" class="form-control-plaintext" id="apellido" readonly value="{{usuario.apellido}}">
                                </div>
                            </div>
                            {{#propio}}
                            <div class="row">
                                <div class="col-6 mb-3">
                                    <label for="anio_nacimiento" class="form-label fs-7 fw-bold text-secondary mb-1">Año de Nacimiento</label>
                                    <input type="text" class="form-control-plaintext" id="anio_nacimiento" readonly value="{{usuario.anio_nacimiento}}">
                                </div>
                                <div class="col-6 mb-3">
                                    <label for="sexo" class="form-label fs-7 fw-bold text-secondary mb-1">Sexo</label>
                                    <input type="text" class="form-control-plaintext" id="sexo" readonly value="{{usuario.sexo}}">
                                </div>
                            </div>
                            {{/propio}}
                            <div class="row">
                                <div class="col-12 col-sm-6 mb-3">
                                    <label for="pais" class="form-label fs-7 fw-bold text-secondary mb-1">País</label>
                                    <input type="text" class="form-control-plaintext" id="pais" readonly value="{{usuario.pais}}">
                                </div>
                                <div class="col-12 col-sm-6 mb-3">
                                    <label for="ciudad" class="form-label fs-7 fw-bold text-secondary mb-1">Ciudad</label>
                                    <input type="text" class="form-control-plaintext" id="ciudad" readonly value="{{usuario.ciudad}}">
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12 mb-3">
                                    <div id="map" class="border border-dark rounded-2" style="height: 300px; width: 100%"></div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <div class="container">
                            <div class="row">
                                <div class="d-flex align-items-center mb-4">
                                    <div class="fs-4 me-2 text-secondary"><i class="bi bi-stopwatch"></i></div>
                                    <div>
                                        <h4 class="fw-bold text-dark mb-0">Últimas Partidas</h4>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light text-secondary small text-uppercase">
                                    <tr>
                                        <th scope="col" class="ps-3">Oponente</th>
                                        <th scope="col">Resultado</th>
                                        <th scope="col">Puntaje</th>
                                        <th scope="col" class="text-end">Fecha</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#partidas}}
                                    <tr>
                                        <td class="ps-3 fw-medium">
                                            {{#oponente_nombre}}
                                                <span class="text-dark">{{oponente_nombre}}</span>
                                                <span class="text-muted d-block small">@{{oponente_username}}</span>
                                            {{/oponente_nombre}}
                                            {{^oponente_nombre}}
                                                <span class="text-secondary italic"><i class="bi bi-robot"></i> Modo Solitario</span>
                                            {{/oponente_nombre}}
                                        </td>
                                        <td>
                                            {{#completada}}
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">Finalizada</span>
                                            {{/completada}}
                                            {{^completada}}
                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2 rounded-pill">En Espera</span>
                                            {{/completada}}
                                        </td>
                                        <td class="fw-bold text-dark fs-5">
                                            {{puntaje}} <span class="fs-6 fw-normal text-muted">pts</span>
                                        </td>
                                        <td class="fw-bold text-dark fs-5 text-end">
                                            <span class="fs-6 fw-normal text-muted">{{fecha_formatted}}</span>
                                        </td>
                                    </tr>
                                    {{/partidas}}

                                    {{^partidas}}
                                    <tr>
                                        <td colspan="4" class="text-center py-5 text-muted">
                                            <p class="mb-2 fs-5">¡Aún no tenés partidas registradas!</p>
                                            <small class="d-block">Hacé clic en "Crear partida" arriba para empezar a sumar puntos.</small>
                                        </td>
                                    </tr>
                                    {{/partidas}}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const map = L.map("map", { zoomControl: false }).setView([{{usuario.latitud}}, {{usuario.longitud}}], 11);
        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
            attribution:
            '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        }).addTo(map);
        L.marker({ lat: {{usuario.latitud}}, lng: {{usuario.longitud}} }).addTo(map);
        map.dragging.disable();
        map.touchZoom.disable();
        map.doubleClickZoom.disable();
        map.scrollWheelZoom.disable();
        map.boxZoom.disable();
        map.keyboard.disable();
        if (map.tap) map.tap.disable();
        document.getElementById('map').style.cursor = 'default';

        const avatarInput = document.getElementById("avatar");
        if (avatarInput) {
            const avatarPreview = document.getElementById("avatarPreview");
            const avatarFilename = document.getElementById("avatarFilename");
            avatarInput.addEventListener("change", (event) => {
                const [file] = avatarInput.files;
                if (file) {
                    avatarPreview.src = URL.createObjectURL(file);
                    avatarFilename.textContent = file.name;
                }
            });
        }
    });
</script>

{{>footer}}