{{> header}}

<div class="container my-5">
    <div class="mb-3">
        <a href="/editor/listarPreguntas" class="text-decoration-none" style="color: #4338CA;">
            ← Volver a Listar Preguntas
        </a>
    </div>

    <div class="mb-4">
        <h2 class="fw-bold" style="color: #1E1B4B;">Modificar Pregunta</h2>
        <p class="text-muted">Editá los datos de la pregunta. Los cambios se guardarán al confirmar.</p>
    </div>

    <div class="card shadow-sm border-0 p-4" style="border-radius: 12px;">
        <form action="/editor/actualizarPregunta" method="POST">

            {{#pregunta}}
            <input type="hidden" name="id" value="{{id}}">

            <div class="mb-4">
                <label for="enunciado" class="form-label fw-semibold text-secondary">Enunciado de la pregunta</label>
                <textarea class="form-control p-3" id="enunciado" name="enunciado" rows="3" style="border-radius: 8px;" required>{{enunciado}}</textarea>
            </div>
            {{/pregunta}}

            <div class="mb-4">
                <label for="categoria_id" class="form-label fw-semibold text-secondary">Categoría</label>
                <select class="form-select p-3" id="categoria_id" name="categoria_id" style="border-radius: 8px;" required>
                    {{#categorias}}
                        <option value="{{id}}">{{nombre}}</option>
                    {{/categorias}}
                </select>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold text-secondary mb-1">Respuestas</label>
                <p class="text-muted small mb-3">Modificá las opciones. Recordá que la primera casilla DEBE contener la respuesta correcta.</p>

                <div class="input-group mb-3">
                    <span class="input-group-text fw-bold text-white bg-success" style="border-radius: 8px 0 0 8px; width: 45px; justify-content: center;">✔</span>
                    <input type="text" class="form-control p-3" name="es_correcta" placeholder="Escribí la respuesta CORRECTA aquí..." style="border-radius: 0 8px 8px 0;" required>
                </div>

                <div class="input-group mb-3">
                    <span class="input-group-text fw-bold text-white bg-danger" style="border-radius: 8px 0 0 8px; width: 45px; justify-content: center;">X</span>
                    <input type="text" class="form-control p-3" name="es_incorrecta_1" placeholder="Opción incorrecta 1..." style="border-radius: 0 8px 8px 0;" required>
                </div>

                <div class="input-group mb-3">
                    <span class="input-group-text fw-bold text-white bg-danger" style="border-radius: 8px 0 0 8px; width: 45px; justify-content: center;">X</span>
                    <input type="text" class="form-control p-3" name="es_incorrecta_2" placeholder="Opción incorrecta 2..." style="border-radius: 0 8px 8px 0;" required>
                </div>

                <div class="input-group mb-4">
                    <span class="input-group-text fw-bold text-white bg-danger" style="border-radius: 8px 0 0 8px; width: 45px; justify-content: center;">X</span>
                    <input type="text" class="form-control p-3" name="es_incorrecta_3" placeholder="Opción incorrecta 3..." style="border-radius: 0 8px 8px 0;" required>
                </div>
            </div>

            <hr class="text-muted my-4">

            <div class="d-flex justify-content-end gap-2">
                <a href="/editor/listarPreguntas" class="btn btn-outline-secondary px-4 py-2" style="border-radius: 8px;">Cancelar</a>
                <button type="submit" class="btn text-white px-4 py-2" style="background-color: #4338CA; border-radius: 8px;">Guardar Cambios</button>
            </div>

        </form>
    </div>
</div>

{{> footer}}