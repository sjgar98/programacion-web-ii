              {{/es_editor}}
              {{#es_admin}}
              <li class="nav-item">
                <a class="nav-link" href="/admin/usuarios">Usuarios</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="/admin/estadisticas">Estadísticas</a>
              </li>
              {{/es_admin}}
            </ul>
            {{#usuario_loggeado}}
            <div class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center gap-2">
              <span class="d-none d-sm-inline">{{username}}</span>
              <a class="btn btn-danger" href="/login/logout">Logout</a>
            </div>
            {{/usuario_loggeado}}
          </div>
        </div>
      </nav>
    </header>
    {{/ocultar_header}}
    <main class="flex-grow-1 d-flex">