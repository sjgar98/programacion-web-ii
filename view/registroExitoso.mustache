{{> header}}

<div class="w3-display-container" style="min-height: 100vh; background-image: url('../public/assets/auth/fondo_registrarse.png'); padding: 40px 16px; display: flex; justify-content: center; align-items: center; font-family: sans-serif;">

    <div class="w3-card-4 w3-white w3-round-large w3-animate-zoom" style="max-width: 550px; width: 100%; border-radius: 20px; padding: 40px 32px; text-align: center;">

        <div class="w3-margin-bottom">
            <img src="../public/assets/auth/preguntados_logo_blanco.png" alt="Preguntados" style="max-width: 140px; margin: 0 auto;">
            <h2 style="font-weight: 900; color: #1e3a8a; margin-top: 8px; letter-spacing: -1px; font-size: 2rem;">PREGUNTADOS</h2>
        </div>

        <div class="w3-margin-top w3-margin-bottom" style="position: relative; display: inline-block; margin-bottom: 30px !important;">
            <div class="w3-light-grey w3-circle" style="width: 140px; height: 140px; display: flex; align-items: center; justify-content: center; background-color: #f0fdf4 !important;">
                <i class="fa fa-envelope-o w3-text-blue" style="font-size: 4rem; opacity: 0.3;"></i>
            </div>
            <span class="w3-green w3-circle" style="position: absolute; top: 10px; right: 10px; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; border: 4px solid white;">
                <i class="fa fa-check" style="font-size: 1.2rem; color: white;"></i>
            </span>
        </div>

        <h3 style="font-weight: bold; color: #1e293b; font-size: 1.8rem; margin-bottom: 8px;">¡Registro exitoso!</h3>
        <p class="w3-text-grey" style="font-size: 1rem; margin-bottom: 24px;">Para activar tu cuenta hacé clic en el siguiente enlace:</p>

        <div class="w3-margin-bottom">
            <a href="/usuario/validar?token={{token}}" class="w3-button w3-green w3-round-large w3-block w3-large" style="border-radius: 12px; padding: 14px; font-weight: bold; background-color: #10b981 !important; transition: background 0.2s;">
                <i class="fa fa-envelope" style="margin-right: 8px;"></i> Activar mi cuenta
            </a>
        </div>

        <div class="w3-center w3-margin-top w3-margin-bottom" style="position: relative; margin: 32px 0 !important;">
            <hr style="border: 0; border-top: 1px solid #e2e8f0;">
            <span class="w3-white w3-text-grey" style="position: absolute; top: -10px; left: 50%; transform: translateX(-50%); padding: 0 10px; font-size: 0.9rem;">o</span>
        </div>

        <p style="margin: 0; font-size: 0.95rem; color: #64748b;">
            ¿Ya tenés cuenta? <a href="/login" style="color: #2563eb; font-weight: bold; text-decoration: none;">Inicia sesión</a>
        </p>

    </div>
</div>

{{> footer}}