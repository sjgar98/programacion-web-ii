{{> header}}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 text-center">
                    
                    <h2 class="card-title fw-bold text-primary mb-4">¡Partida finalizada!</h2>
                    
                    <div class="mb-4">
                        <p class="text-muted mb-1">Resumen del desempeño</p>
                        <hr class="w-50 mx-auto">
                    </div>

                    <div class="row text-start px-3 mb-4">
                        <div class="col-6 mb-3">
                            <small class="text-uppercase text-muted d-block">Puntaje obtenido</small>
                            <span class="fs-4 fw-bold text-dark">{{puntaje}}</span>
                        </div>
                        <div class="col-6 mb-3">
                            <small class="text-uppercase text-muted d-block">Fecha</small>
                            <span class="fs-6 fw-semibold text-dark">{{fecha}}</span>
                        </div>
                    </div>

                    <div class="mt-4 text-start">
                        <h5 class="fw-bold mb-3">Detalle de preguntas:</h5>
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Pregunta</th>
                                        <th class="text-center">Estado</th>
                                        <th class="text-center">Reportar</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#preguntas}}
                                    <tr>
                                        <td>{{enunciado}}</td>
                                        <td class="text-center">
                                            {{#es_correcta}}<span class="badge bg-success">Correcta</span>{{/es_correcta}}
                                            {{^es_correcta}}<span class="badge bg-danger">Incorrecta</span>{{/es_correcta}}
                                        </td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-outline-warning btn-sm" data-bs-toggle="modal" data-bs-target="#reporteModal{{id}}">
                                                Reportar
                                            </button>
                                        </td>
                                    </tr>
                                    {{/preguntas}}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    {{#preguntas}}
                    <div class="modal fade" id="reporteModal{{id}}" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">Reportar Pregunta</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <form action="/reportes/registrarReporte" method="POST">
                                    <div class="modal-body">
                                        <input type="hidden" name="pregunta_id" value="{{id}}">
                                        <label class="form-label">Pregunta:</label>
                                        <textarea class="form-control mb-3" readonly>{{enunciado}}</textarea>
                                        <label class="form-label">Motivo del reporte:</label>
                                        <textarea name="texto" class="form-control" required placeholder="Escribe aquí el motivo del reporte..."></textarea>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                        <button type="submit" class="btn btn-danger">Enviar Reporte</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    {{/preguntas}}
                    {{#mensaje_reporte}}
<div class="alert alert-success alert-dismissible fade show text-center mb-4" role="alert">
    <strong>¡Éxito!</strong> Reporte enviado correctamente.
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
{{/mensaje_reporte}}

                    <div class="d-grid gap-2 mt-4">
                        <a href="/lobby" class="btn btn-primary btn-lg rounded-pill shadow-sm">
                            Volver al Home
                        </a>
                    </div>
                </div>
            </div>
            
        </div>
    </div>
</div>
{{> footer}}