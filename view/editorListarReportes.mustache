{{> header}}

<main class="container my-5">

    <div class="row mb-4">
        <div class="col-12">
            <h1 class="fw-bold text-dark m-0" style="color: #1E293B;">Listar Reportes</h1>
            <p class="text-muted fs-5 mt-1 m-0">Revisá y gestioná las denuncias realizadas por los usuarios.</p>
        </div>
    </div>



    <div class="card border-0 shadow-sm p-4" style="background-color: #F8FAFC; border-radius: 16px;">
        <div class="table-responsive">
            <table class="table table-hover align-middle m-0">
                <thead class="table-light text-muted">
                    <tr>
                        <th scope="col" class="py-3 border-0" style="width: 100px;">ID REPORTE</th>
                        <th scope="col" class="py-3 border-0">USUARIO</th>
                        <th scope="col" class="py-3 border-0">PREGUNTA REPORTADA</th>
                        <th scope="col" class="py-3 border-0">MOTIVO</th>
                        <th scope="col" class="py-3 border-0 text-center" style="width: 320px;">ACCIONES</th>
                    </tr>
                </thead>
                <tbody>
                    {{#reportes}}
                    <tr style="border-bottom: 1px solid #E2E8F0;">
                        <th scope="row" class="text-muted fw-normal py-3">#{{id}}</th>

                        <td class="fw-semibold text-dark">
                            <div class="d-flex align-items-center gap-2">
                                <span class="fs-5">👤</span>
                                <div>
                                    <div class="m-0 p-0 leading-tight">{{username}}</div>
                                </div>
                            </div>
                        </td>

                        <td class="text-dark">{{enunciado}}</td>

                        <td>
                            <span class="badge px-2.5 py-1.5 fw-semibold" style="border-radius: 6px; background-color: #FEE2E2; color: #EF4444;">
                                ⚠️ {{motivo}}
                            </span>
                        </td>

                        <td class="text-center">
                            <div class="d-flex justify-content-center gap-2">
                                <a href="/editor/aceptarReporte?reporte_id={{id}}&pregunta_id={{pregunta_id}}"
                                   class="btn btn-outline-danger btn-sm px-3 py-2 fw-semibold d-inline-flex align-items-center"
                                   style="border-radius: 8px; border-color: #EF4444; color: #EF4444;"
                                   onclick="return confirm('¿Seguro que querés aceptar el reporte? Se dará de baja la pregunta.')">
                                    <i class="bi bi-x-circle me-1"></i> Aceptar Reporte
                                </a>

                                <a href="/editor/ignorarReporte?reporte_id={{id}}"
                                   class="btn btn-outline-success btn-sm px-3 py-2 fw-semibold d-inline-flex align-items-center"
                                   style="border-radius: 8px; border-color: #10B981; color: #10B981;">
                                    <i class="bi bi-check2-circle me-1"></i> Ignorar Reporte
                                </a>
                            </div>
                        </td>
                    </tr>
                    {{/reportes}}

                    {{^reportes}}
                    <tr>
                        <td colspan="5" class="text-center text-muted py-5 fs-5">
                            🎉 ¡Excelente! No hay reportes pendientes de revisión.
                        </td>
                    </tr>
                    {{/reportes}}
                </tbody>
            </table>
        </div>
    </div>

</main>

{{> footer}}