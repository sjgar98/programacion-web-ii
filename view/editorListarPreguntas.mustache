{{> header}}

<main class="container my-5">

    <div class="row mb-4 align-items-center">
        <div class="col-12 col-md-8">
            <h1 class="fw-bold text-dark m-0" style="color: #1E293B;">Listar Preguntas</h1>
            <p class="text-muted fs-5 mt-1 m-0">Gestioná todas las preguntas del juego.</p>
        </div>
        <div class="col-12 col-md-4 text-md-end mt-3 mt-md-0">
            <a href="/editor/crearNuevaPregunta" class="btn text-white px-4 py-2.5 fw-semibold d-inline-flex align-items-center shadow-sm" style="background-color: #6366F1; border-radius: 10px;">
                <i class="bi bi-plus-circle me-2"></i> Agregar Nueva Pregunta
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm p-4" style="background-color: #F8FAFC; border-radius: 16px;">
        <div class="table-responsive">
            <table class="table table-hover align-middle m-0">
                <thead class="table-light text-muted">
                    <tr>
                        <th scope="col" class="py-3 border-0" style="width: 80px;">ID</th>
                        <th scope="col" class="py-3 border-0">ENUNCIADO</th>
                        <th scope="col" class="py-3 border-0">CATEGORÍA</th>
                        <th scope="col" class="py-3 border-0">ESTADO</th>
                        <th scope="col" class="py-3 border-0 text-center" style="width: 220px;">ACCIONES</th>
                    </tr>
                </thead>
                <tbody>
                    {{#preguntas}}
                    <tr style="border-bottom: 1px solid #E2E8F0;">
                        <th scope="row" class="text-muted fw-normal py-3">{{id}}</th>

                        <td class="fw-semibold text-dark">{{enunciado}}</td>

                        <td>
                            <span class="badge px-3 py-2 fw-semibold fs-6 d-inline-flex align-items-center gap-1"
                                  style="border-radius: 8px;
                                         background-color: #EEF2FF;
                                         color: #6366F1;">
                                📊 {{categoria}}
                            </span>
                        </td>

                        <td>
                            <span class="badge bg-success-subtle text-success px-3 py-2 fw-semibold fs-6" style="border-radius: 20px;">
                                <i class="bi bi-check-circle-fill me-1"></i> Activa
                            </span>
                        </td>

                        <td class="text-center">
                            <div class="d-flex justify-content-center gap-2">
                                <a href="/editor/modificarPregunta?pregunta_id={{id}}" class="btn btn-outline-primary btn-sm px-3 py-1.5 fw-semibold d-inline-flex align-items-center" style="border-radius: 8px; border-color: #3B82F6; color: #3B82F6;">
                                    <i class="bi bi-pencil me-1"></i> Editar
                                </a>

                                <a href="/editor/eliminarPregunta?pregunta_id={{id}}" class="btn btn-outline-danger btn-sm px-3 py-1.5 fw-semibold d-inline-flex align-items-center" style="border-radius: 8px; border-color: #EF4444; color: #EF4444;" onclick="return confirm('¿Seguro que querés dar de baja esta pregunta?')">
                                    <i class="bi bi-trash me-1"></i> Eliminar
                                </a>
                            </div>
                        </td>
                    </tr>
                    {{/preguntas}}

                    {{^preguntas}}
                    <tr>
                        <td colspan="5" class="text-center text-muted py-5 fs-5">
                            No hay preguntas registradas en el sistema.
                        </td>
                    </tr>
                    {{/preguntas}}
                </tbody>
            </table>
        </div>
    </div>

</main>

{{> footer}}