{{> header}}

<main class="container my-5">

    <div class="row mb-4 align-items-center">
        <div class="col-12 col-md-8">
            <h1 class="fw-bold text-dark m-0" style="color: #1E293B;">Listar Categorías</h1>
            <p class="text-muted fs-5 mt-1 m-0">Gestioná todas las categorías del juego.</p>
        </div>
        <div class="col-12 col-md-4 text-md-end mt-3 mt-md-0">
            <a href="/editor/crearNuevaCategoria" class="btn text-white px-4 py-2.5 fw-semibold d-inline-flex align-items-center shadow-sm" style="background-color: #6366F1; border-radius: 10px;">
                <i class="bi bi-plus-circle me-2"></i> Agregar Nueva Categoría
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm p-4" style="background-color: #F8FAFC; border-radius: 16px;">
        <div class="table-responsive">
            <table class="table table-hover align-middle m-0">
                <thead class="table-light text-muted">
                    <tr>
                        <th scope="col" class="py-3 border-0" style="width: 80px;">ID</th>
                        <th scope="col" class="py-3 border-0">NOMBRE</th>
                        <th scope="col" class="py-3 border-0">COLOR</th>
                        <th scope="col" class="py-3 border-0 text-center" style="width: 220px;">ACCIONES</th>
                    </tr>
                </thead>
                <tbody>
                    {{#categorias}}
                    <tr style="border-bottom: 1px solid #E2E8F0;">
                        <th scope="row" class="text-muted fw-normal py-3">{{id}}</th>
                        <td class="fw-semibold text-dark">{{nombre}}</td>
                        <td>
                            <input type="color" value="{{color}}" disabled class="form-control form-control-color p-0 border-0" style="width: 40px; height: 40px; cursor: not-allowed;">
                        </td>
                        <td class="text-center">
                            <div class="d-flex justify-content-center gap-2">
                                <a href="/editor/modificarCategoria?categoria_id={{id}}" class="btn btn-outline-primary btn-sm px-3 py-1.5 fw-semibold d-inline-flex align-items-center" style="border-radius: 8px; border-color: #3B82F6; color: #3B82F6;">
                                    <i class="bi bi-pencil me-1"></i> Editar
                                </a>

                                <a href="/editor/eliminarCategoria?categoria_id={{id}}" class="btn btn-outline-danger btn-sm px-3 py-1.5 fw-semibold d-inline-flex align-items-center" style="border-radius: 8px; border-color: #EF4444; color: #EF4444;" onclick="return confirm('¿Seguro que querés dar de baja esta categoría?')">
                                    <i class="bi bi-trash me-1"></i> Eliminar
                                </a>
                            </div>
                        </td>
                    </tr>
                    {{/categorias}}

                    {{^categorias}}
                    <tr>
                        <td colspan="4" class="text-center text-muted py-5 fs-5">
                            No hay categorías registradas en el sistema.
                        </td>
                    </tr>
                    {{/categorias}}
                </tbody>
            </table>
        </div>
    </div>

</main>

{{> footer}}