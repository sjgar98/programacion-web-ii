{{>header}}

{{#error}}
<div class="row w-100 justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="alert alert-danger alert-dismissible fade show rounded-4 mb-4 shadow-sm small d-flex align-items-center" role="alert">
            <i class="material-symbols-outlined me-2">exclamation</i>
            <div><strong>Error:</strong> {{error}}</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
</div>
{{/error}}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">

            <div class="progress mb-3 rounded-pill shadow-sm" style="height: 18px;">
                <div
                    id="timerBar"
                    class="progress-bar bg-success progress-bar-striped progress-bar-animated fw-bold text-white"
                    role="progressbar"
                    style="width: 100%;"
                >
                    <span id="timerText" class="small">{{tiempo_restante}}</span>
                </div>
            </div>

            <div class="card shadow-lg border-0 rounded-4 text-center">

                <div class="card-header bg-primary text-white py-2 border-0">
                    <span class="badge bg-white text-primary rounded-pill px-3 py-2 fw-bold text-uppercase">
                        ¡A Jugar!
                    </span>
                </div>

                <div class="card-body p-3 p-md-4">

                    {{#pregunta}}
                    <div class="mb-4">
                        <h2 class="h4 fw-bold text-dark mb-0">
                            {{enunciado}}
                        </h2>
                    </div>
                    {{/pregunta}}

                    {{^pregunta}}
                    <div class="py-3 text-muted">
                        <i class="material-symbols-outlined display-5 text-warning mb-2">help_center</i>
                        <p class="fs-6 fw-semibold mb-0">No se encontró la pregunta actual.</p>
                    </div>
                    {{/pregunta}}

                    {{#pregunta}}

                    <form id="formPartida" action="/partida/verificarRespuesta" method="POST" class="d-grid gap-2">

                        {{#respuesta}}
                        <button
                            type="submit"
                            name="id_respuesta"
                            value="{{id}}"
                            class="btn btn-outline-primary btn-lg text-start py-2 px-3 rounded-pill shadow-sm fw-bold d-flex align-items-center"
                        >
                            <span class="badge bg-primary-subtle text-primary rounded-circle me-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width:26px;height:26px;">
                                ✓
                            </span>

                            <span class="flex-grow-1 text-dark text-wrap">
                                {{texto}}
                            </span>
                        </button>
                        {{/respuesta}}

                    </form>

                    <form id="usarTrampa" action="/partida/usarTrampa" method="POST" class="mt-3">

                        {{#trampa}}
                            {{#cantidad}}
                            <button type="submit" class="btn btn-warning rounded-pill fw-bold px-4 py-2">
                                Usar Trampa (Disponibles: {{cantidad}})
                            </button>
                            {{/cantidad}}

                            {{^cantidad}}
                            <button type="button" class="btn btn-secondary rounded-pill fw-bold px-4 py-2" disabled>
                                Sin trampas
                            </button>
                            {{/cantidad}}
                        {{/trampa}}

                        {{^trampa}}
                        <button type="button" class="btn btn-secondary rounded-pill fw-bold px-4 py-2" disabled>
                            Sin trampas
                        </button>
                        {{/trampa}}

                    </form>

                    {{/pregunta}}

                </div>

                <div class="card-footer bg-light py-2 border-0 text-muted small fw-medium">
                    Partida en curso • El tiempo corre
                </div>

            </div>

        </div>
    </div>
</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {

        const tiempoBackend = "{{tiempo_restante}}";
        let tiempoRestante = (tiempoBackend !== "") ? parseInt(tiempoBackend) : 60;
        const totalTiempo = 60; 
        
        const timerBar = document.getElementById("timerBar");
        const timerText = document.getElementById("timerText");
        const formPartida = document.getElementById("formPartida");

        if (!formPartida) return;

        function actualizarBarra() {

            if (tiempoRestante < 0) tiempoRestante = 0;
            
            timerText.textContent = tiempoRestante;
            let porcentaje = (tiempoRestante / totalTiempo) * 100;
            if (porcentaje < 0) porcentaje = 0;
            timerBar.style.width = porcentaje + "%";

            if (tiempoRestante <= 30 && tiempoRestante > 10) {
                timerBar.classList.remove("bg-success");
                timerBar.classList.add("bg-warning");
                timerBar.classList.remove("text-white");
                timerBar.classList.add("text-dark");
            } else if (tiempoRestante <= 10) {
                timerBar.classList.remove("bg-warning");
                timerBar.classList.add("bg-danger");
                timerBar.classList.remove("text-dark");
                timerBar.classList.add("text-white");
            }
        }


        actualizarBarra();

        const cuentaRegresiva = setInterval(function () {
            tiempoRestante--;
            actualizarBarra();

            if (tiempoRestante <= 0) {
                clearInterval(cuentaRegresiva);
                formPartida.submit(); 
            }
        }, 1000);
    });
</script>

{{>footer}}