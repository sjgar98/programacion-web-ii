{{> header}}

<main class="container my-5">

    <div class="row mb-5">
        <div class="col-12">
            <h1 class="fw-bold text-dark m-0" style="color: #1E293B;">Panel de Control del Editor</h1>
            <p class="text-muted fs-5 mt-1">Gestioná el contenido del juego y ayudá a mantener Preguntados genial.</p>
            <hr class="mt-2" style="width: 60px; height: 4px; background-color: #6366F1; border: none; opacity: 1;">
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-12 col-md-4">
            <div class="card h-100 border-0 shadow-sm p-4 text-center justify-content-between" style="background-color: #F8FAFC; border-radius: 16px;">
                <div class="my-3">
                    <div class="d-inline-flex align-items-center justify-content-center mb-4" style="width: 90px; height: 90px; background-color: #F0FDF4; border-radius: 50%;">
                        <i class="bi bi-tags fs-1" style="color: #22C55E;"></i>
                    </div>
                    <h3 class="fw-bold h4 text-dark mb-2">Listar Categorías</h3>
                    <p class="text-muted px-2">Ver y administrar todas las categorías de preguntas.</p>
                </div>
                <a href="/editor/listarCategorias" class="btn text-white w-100 py-2.5 fw-semibold d-flex align-items-center justify-content-center" style="background-color: #22C55E; border-radius: 10px;">
                    Ir a Categorías <i class="bi bi-chevron-right ms-2 fs-6"></i>
                </a>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card h-100 border-0 shadow-sm p-4 text-center justify-content-between" style="background-color: #F8FAFC; border-radius: 16px;">
                <div class="my-3">
                    <div class="d-inline-flex align-items-center justify-content-center mb-4" style="width: 90px; height: 90px; background-color: #EEF2FF; border-radius: 50%;">
                        <i class="bi bi-list-task fs-1" style="color: #6366F1;"></i>
                    </div>
                    <h3 class="fw-bold h4 text-dark mb-2">Listar Preguntas</h3>
                    <p class="text-muted px-2">Ver y administrar todas las preguntas del juego.</p>
                </div>
                <a href="/editor/listarPreguntas" class="btn text-white w-100 py-2.5 fw-semibold d-flex align-items-center justify-content-center" style="background-color: #6366F1; border-radius: 10px;">
                    Ir a Preguntas <i class="bi bi-chevron-right ms-2 fs-6"></i>
                </a>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card h-100 border-0 shadow-sm p-4 text-center justify-content-between" style="background-color: #F8FAFC; border-radius: 16px;">
                <div class="my-3">
                    <div class="d-inline-flex align-items-center justify-content-center mb-4" style="width: 90px; height: 90px; background-color: #EFF6FF; border-radius: 50%;">
                        <i class="bi bi-shield-exclamation fs-2" style="color: #3B82F6;"></i>
                    </div>
                    <h3 class="fw-bold h4 text-dark mb-2">Listar Reportes</h3>
                    <p class="text-muted px-2">Revisar los reportes realizados por los jugadores.</p>
                </div>
                <a href="/reportes" class="btn text-white w-100 py-2.5 fw-semibold d-flex align-items-center justify-content-center" style="background-color: #3B82F6; border-radius: 10px;">
                    Ir a Reportes <i class="bi bi-chevron-right ms-2 fs-6"></i>
                </a>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card h-100 border-0 shadow-sm p-4 text-center justify-content-between" style="background-color: #F8FAFC; border-radius: 16px;">
                <div class="my-3">
                    <div class="d-inline-flex align-items-center justify-content-center mb-4" style="width: 90px; height: 90px; background-color: #ECFDF5; border-radius: 50%;">
                        <i class="bi bi-lightbulb fs-1" style="color: #10B981;"></i>
                    </div>
                    <h3 class="fw-bold h4 text-dark mb-2">Preguntas Sugeridas</h3>
                    <p class="text-muted px-2">Explorar y gestionar las preguntas sugeridas por la comunidad.</p>
                </div>
                <a href="/editor/verPreguntasSugeridas" class="btn text-white w-100 py-2.5 fw-semibold d-flex align-items-center justify-content-center" style="background-color: #10B981; border-radius: 10px;">
                    Ir a Sugeridas <i class="bi bi-chevron-right ms-2 fs-6"></i>
                </a>
            </div>
        </div>

    </div>

</main>

{{> footer}}